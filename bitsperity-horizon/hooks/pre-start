#!/usr/bin/env bash
# umbreld runs this on the host before the app's containers start, on install,
# start and update. An update copies only docker-compose.yml, umbrel-app.yml and
# hooks/ into ${APP_DATA_DIR}, so relay-config.json and signer-config.json keep
# the content of the version that was installed first.
#
# A file that still holds a default an earlier version shipped gets the current
# default. Any other content is the user's and stays. Comparison ignores
# whitespace. The file is rewritten in place: it is a single-file bind mount.
set -euo pipefail

data_dir="${APP_DATA_DIR:?APP_DATA_DIR is not set}"

# refresh_default FILE CURRENT [EARLIER...]
refresh_default() {
  local file="${data_dir}/$1" current="$2"
  shift 2
  # Docker creates an empty directory for a missing bind source.
  if [[ -d "${file}" ]]; then
    rmdir "${file}" 2>/dev/null || return 0
  fi
  if [[ -e "${file}" ]]; then
    local content earlier
    content="$(tr -d ' \t\r\n' < "${file}")"
    for earlier in "$@"; do
      if [[ "${content}" == "${earlier}" ]]; then
        printf '%s\n' "${current}" > "${file}"
        return 0
      fi
    done
    return 0
  fi
  printf '%s\n' "${current}" > "${file}"
}

# Umbrel package 0.1.2 and 0.1.3 shipped ws://umbrel.local:4848, unreachable from https pages.
refresh_default relay-config.json '{
  "relays": ["self"],
  "bootstrap": []
}' '{"relays":["ws://umbrel.local:4848"],"bootstrap":[]}'

# Umbrel package 0.1.0 to 0.1.2 also shipped mailboxPort, which Horizon no longer reads.
refresh_default signer-config.json '{
  "signerUiPort": 8740
}' '{"mailboxPort":8741,"signerUiPort":8740}'
