#!/usr/bin/env bash
# umbreld runs this on the host before the app's containers start, on install,
# start and update. The web container runs as the image's node user (uid 1000).
# Docker creates a missing bind source as root, which the node user cannot write.
# data/ holds the agents, their MCP token digests, Forester's Moonstone client key
# and the access log: owned by uid 1000, mode 700. Existing files stay.
set -euo pipefail

data_dir="${APP_DATA_DIR:?APP_DATA_DIR is not set}/data"
mkdir -p "${data_dir}"
chown 1000:1000 "${data_dir}"
chmod 700 "${data_dir}"
